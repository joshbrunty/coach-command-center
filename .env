# Copy to .env before running Docker Compose.

# Database credentials used by the Postgres container and API connection string.
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-this-before-live-use
POSTGRES_DB=coach_command_center

# Logical namespace inside the storage table. Change this if one database hosts
# multiple independent command centers.
APP_NAMESPACE=coach-command-center

# Production serving.
# Use ":80" for local HTTP, or a real hostname for Caddy automatic HTTPS.
APP_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Development ports.
WEB_DEV_PORT=5173
API_DEV_PORT=3000
CHOKIDAR_USEPOLLING=true

# Optional if you call the API directly from a different browser origin.
# Vite dev normally proxies /api, so this can stay empty.
CORS_ORIGIN=cyberteam
