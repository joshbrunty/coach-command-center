# Copy to .env before running Docker Compose.

# Database credentials used by the Postgres container and API connection string.
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-this-before-live-use
POSTGRES_DB=coach_command_center

# Logical namespace inside the storage table. Change this if one database hosts
# multiple independent command centers.
APP_NAMESPACE=coach-command-center

# Production serving.
# Use ":80" for local HTTP, or a real hostname for Caddy automatic HTTPS.
APP_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Development ports.
WEB_DEV_PORT=5173
API_DEV_PORT=3000
CHOKIDAR_USEPOLLING=true

# Optional if you call the API directly from a different browser origin.
# Vite dev normally proxies /api, so this can stay empty.
CORS_ORIGIN=cyberteam

# -----------------------------------------------------------------------------
# Observability stack (docker compose --profile obs)
# -----------------------------------------------------------------------------
# Independent of the dev/prod profiles. Brings up Prometheus, Grafana, and the
# scoreboard-exporter with the Coach Scoreboard dashboard auto-loaded.

# Published ports.
OBS_GRAFANA_PORT=3001
OBS_PROM_PORT=9090
OBS_EXPORTER_PORT=9101

# Grafana admin credentials. Change before exposing beyond the tailnet.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=coach-admin

# Exporter input. Use 'sqlite' for replay/dev/fallback or 'http' for the live
# event endpoint.
SCOREBOARD_SOURCE=sqlite

# HTTP adapter (used when SCOREBOARD_SOURCE=http). Set to the scoreboard base
# URL (e.g. https://icc2026.cybersecnatlab.it). The adapter calls /api/status
# and /api/scoreboard/table/{round} automatically.
SCOREBOARD_HTTP_URL=
SCOREBOARD_HTTP_POLL_INTERVAL_SECONDS=120
SCOREBOARD_HTTP_TIMEOUT_MS=4000

# SQLite adapter (used when SCOREBOARD_SOURCE=sqlite). Path is inside the
# exporter container; the compose file bind-mounts grafana/setup_data/ for you.
SCOREBOARD_SQLITE_PATH=/data/setup_data/scoreboard_history_setup.db
SCOREBOARD_SQLITE_POLL_INTERVAL_SECONDS=5
# 'fast' replays the SQLite history as fast as scrapes allow (good for dashboard
# development). 'realtime' emits one tick every GAME_TICK_LENGTH_SECONDS.
REPLAY_RATE=fast

# Which scoreboard team name maps to our_* metrics.
OUR_TEAM_NAME=Team USA

# Canonical tick length, used to compute game_seconds_to_next_tick and to space
# realtime replays.
GAME_TICK_LENGTH_SECONDS=120
